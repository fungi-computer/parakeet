{
  "name": "@fungi.computer/parakeet",
  "version": "0.12.5",
  "author": "Levi <levi@technomancy.dev>",
  "private": false,
  "description": "Standalone React composer for a typed Shiitake Session",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./conversation-view": {
      "types": "./dist/conversation-view.d.ts",
      "import": "./dist/conversation-view.js"
    },
    "./conversation-opening": {
      "types": "./dist/conversation-opening.d.ts",
      "import": "./dist/conversation-opening.js"
    },
    "./agent-head": {
      "types": "./dist/agent-head.d.ts",
      "import": "./dist/agent-head.js"
    },
    "./website-visitor-client": {
      "types": "./dist/website-visitor-client.d.ts",
      "import": "./dist/website-visitor-client.js"
    },
    "./slash": {
      "types": "./dist/commands/slash.d.ts",
      "import": "./dist/commands/slash.js"
    },
    "./completion-menu": {
      "types": "./dist/components/CompletionMenu.d.ts",
      "import": "./dist/components/CompletionMenu.js"
    },
    "./completion-menu.css": "./src/completion-menu.css",
    "./composer-shell.css": "./src/composer-shell.css",
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "src/styles.css",
    "src/completion-menu.css",
    "src/composer-shell.css",
    "docs/api"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && pnpm run build:css",
    "sync:injected": "node --input-type=module --eval \"import { access } from 'node:fs/promises'; await access('dist/headless.d.ts');\"",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css",
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "browser:contract": "pnpm run build:css && node test/browser/contract.mjs",
    "smoke": "node test/stranger/runtime.mjs",
    "browser:client-inspections": "pnpm run build:css && node test/browser/client-inspections.mjs",
    "prepack": "node scripts/prepare-package.mjs"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.102.8",
    "react": "^18.2.0 || ^19.2.0",
    "react-dom": "^18.2.0 || ^19.2.0"
  },
  "devDependencies": {
    "@fungi.computer/parakeet-testing": "0.2.32",
    "@ladle/react": "5.1.1",
    "@tailwindcss/cli": "4.2.1",
    "@tailwindcss/typography": "0.5.19",
    "@tanstack/react-query": "5.102.8",
    "@types/node": "24.13.3",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.3",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@fungi.computer/agar": "0.20.0",
    "@fungi.computer/bird-dog": "0.3.7",
    "@fungi.computer/cairn": "0.1.0",
    "@fungi.computer/caps": "0.12.0",
    "@fungi.computer/gills": "0.3.0",
    "@fungi.computer/knapsack": "0.4.16",
    "@fungi.computer/mule": "0.2.5",
    "@fungi.computer/shiitake": "0.20.0",
    "@fungi.computer/sigils": "0.3.2",
    "@fungi.computer/sprite": "0.2.2",
    "@fungi.computer/sprite-zdog": "0.3.2",
    "@fungi.computer/whistle": "0.3.0",
    "@tanstack/markdown": "0.0.12",
    "@tanstack/react-virtual": "3.14.10",
    "acorn": "8.18.0",
    "diff": "8.0.4",
    "effect": "4.0.2",
    "eventsource": "5.1.1",
    "jotai": "2.20.3",
    "jotai-tanstack-query": "0.11.0",
    "lucide-react": "0.460.0",
    "strip-ansi": "7.2.0",
    "zod": "4.4.3"
  },
  "dependenciesMeta": {
    "@fungi.computer/caps": {
      "injected": true
    }
  },
  "botanical": {
    "role": "package",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": "required",
      "docs": "required",
      "pack": "required",
      "smoke": "required",
      "stranger": "required"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/parakeet.git"
  },
  "publishConfig": {
    "directory": ".botanical/package",
    "linkDirectory": false
  },
  "fungi": {
    "build": {
      "stylesheet": {
        "input": "src/styles.css",
        "output": "dist/styles.css"
      }
    }
  }
}
